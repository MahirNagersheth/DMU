set number format of range "M4:O1003" of active sheet to "\"$\"#,##0.00;(\"$\"#,##0.00)"
set value of range "R4" of active sheet to {{4000}}
set formula of range "N4" of active sheet to "=3000+2*$R$4"
fill down range "N4:N1003" of active sheet
set formula of range "R7" of active sheet to "=AVERAGE(O4:O403)"
set formula of range "R8" of active sheet to "=STDEV.S(O4:O403)"
set formula of range "R9" of active sheet to "=R7-T.INV.2T(0.05,R11-1)*R8/SQRT(R11)"
set formula of range "R10" of active sheet to "=R7+T.INV.2T(0.05,R11-1)*R8/SQRT(R11)"
set value of range "Q9:Q10" of active sheet to {{"Lower 95% CI"},{"Upper 95% CI"}}
set value of range "Q13:R14" of active sheet to {{"Fixed cost",3000},{"Cost per fish",2}}
set formula of range "N4" of active sheet to "=$R$13+$R$14*$R$4"
fill down range "N4:N1003" of active sheet
set formula of range "U3" of active sheet to "=R7"
data table range "T3:U44" of active sheet column input range "R4" of active sheet
set number format of range "R7:R10" of active sheet to "\"$\"#,##0.00"
set number format of range "U4:U44" of active sheet to "\"$\"#,##0.00"
set column width of range "Q:Q" of active sheet to 22
set column width of range "R:R" of active sheet to 18
set column width of range "U:U" of active sheet to 18
set calculation to calculation automatic
calculate full
save active workbook
end tell
